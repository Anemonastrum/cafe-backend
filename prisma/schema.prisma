/// SQL CHECK constraints: chk_payments_amount, chk_payments_cash.
model payments {
  id                            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                      BigInt            @db.UnsignedBigInt
  shift_id                      BigInt?           @db.UnsignedBigInt
  payment_method_id             BigInt            @db.UnsignedBigInt
  payment_reference             String            @db.VarChar(80)
  idempotency_key               String            @db.VarChar(120)
  request_hash                  String?           @db.Char(64)
  amount                        Decimal           @db.Decimal(14, 2)
  cash_received                 Decimal?          @db.Decimal(14, 2)
  cash_change                   Decimal?          @db.Decimal(14, 2)
  status                        payments_status   @default(pending)
  provider                      payments_provider @default(manual)
  gateway_order_id              String?           @db.VarChar(120)
  gateway_transaction_id        String?           @db.VarChar(120)
  gateway_status                String?           @db.VarChar(80)
  gateway_attempt_snapshot      Json?
  gateway_charge_started_at     DateTime?         @db.DateTime(3)
  processed_by_user_id          BigInt            @db.UnsignedBigInt
  paid_at                       DateTime?         @db.DateTime(3)
  failed_at                     DateTime?         @db.DateTime(3)
  created_at                    DateTime          @default(now()) @db.DateTime(3)
  /// Database-managed ON UPDATE CURRENT_TIMESTAMP(3); retained in migration SQL.
  updated_at                    DateTime          @default(now()) @db.DateTime(3)
  fk_payments_order             orders            @relation("fk_payments_order", fields: [order_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payments_order")
  fk_payments_shift             cashier_shifts?   @relation("fk_payments_shift", fields: [shift_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payments_shift")
  fk_payments_method            payment_methods   @relation("fk_payments_method", fields: [payment_method_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payments_method")
  fk_payments_user              users             @relation("fk_payments_user", fields: [processed_by_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payments_user")
  fk_payment_event_payment_back payment_events[]  @relation("fk_payment_event_payment")
  fk_receipts_payment_back      receipts?         @relation("fk_receipts_payment")

  @@unique([payment_reference], map: "uq_payments_reference")
  @@unique([idempotency_key], map: "uq_payments_idempotency")
  @@unique([gateway_order_id], map: "uq_payments_gateway_order")
  @@unique([gateway_transaction_id], map: "uq_payments_gateway_transaction")
  @@index([order_id, status], map: "idx_payments_order_status")
  @@index([payment_method_id, paid_at], map: "idx_payments_method_paid")
  @@index([shift_id], map: "idx_payments_shift")
}

model payment_events {
  id                       BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id               BigInt   @db.UnsignedBigInt
  provider_event_id        String?  @db.VarChar(150)
  event_type               String   @db.VarChar(80)
  payload                  Json?
  received_at              DateTime @default(now()) @db.DateTime(3)
  fk_payment_event_payment payments @relation("fk_payment_event_payment", fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_event_payment")

  @@unique([provider_event_id], map: "uq_payment_events_provider_id")
  @@index([payment_id, received_at], map: "idx_payment_events_payment_time")
}

model receipts {
  id                            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id                    BigInt                   @db.UnsignedBigInt
  receipt_number                String                   @db.VarChar(80)
  cafe_name_snapshot            String                   @db.VarChar(180)
  cashier_name_snapshot         String?                  @db.VarChar(150)
  cafe_address_snapshot         String?                  @db.Text
  cafe_phone_snapshot           String?                  @db.VarChar(50)
  currency_snapshot             String                   @default("IDR") @db.Char(3)
  paper_mm                      receipts_paper_mm        @default(value_80)
  footer_snapshot               String?                  @db.VarChar(500)
  pdf_url                       String?                  @db.VarChar(1024)
  digital_delivery_email        String?                  @db.VarChar(190)
  delivery_status               receipts_delivery_status @default(not_requested)
  issued_by_user_id             BigInt?                  @db.UnsignedBigInt
  issued_at                     DateTime                 @default(now()) @db.DateTime(3)
  fk_receipts_payment           payments                 @relation("fk_receipts_payment", fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receipts_payment")
  fk_receipts_user              users?                   @relation("fk_receipts_user", fields: [issued_by_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receipts_user")
  fk_receipt_event_receipt_back receipt_events[]         @relation("fk_receipt_event_receipt")

  @@unique([payment_id], map: "uq_receipts_payment")
  @@unique([receipt_number], map: "uq_receipts_number")
}

