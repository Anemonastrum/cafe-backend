# Example only. Replace credentials before deployment; never commit .env.
# Explicit loading: node --env-file=.env src/server.js
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
CSRF_KEY=
READINESS_SECRET=
# Generate separate random secrets of at least 32 bytes.
ALLOW_INSECURE_COOKIE=false
# Default false; only explicit comma-separated IP/CIDR trusted proxy peers.
# Same-host nginx example: 127.0.0.1/32,::1/128 (firewall backend first).
TRUST_PROXY=false
STORAGE_DIR=storage
DATABASE_URL="mysql://cafe_user:CHANGE_ME@127.0.0.1:3306/cafe_pos"
