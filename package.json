{
  "name": "cafe-backend",
  "version": "1.0.0",
  "description": "backend for cafe pos system",
  "homepage": "https://github.com/Anemonastrum/cafe-backend#readme",
  "bugs": {
    "url": "https://github.com/Anemonastrum/cafe-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anemonastrum/cafe-backend.git"
  },
  "license": "MIT",
  "author": "Anemonastrum",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:concurrency": "node scripts/test.mjs concurrency",
    "test:all": "npm test && npm run test:integration && npm run test:concurrency",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:drift": "node scripts/check-database.mjs",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:check": "node scripts/check-schema.mjs",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "fontkit": "2.0.4",
    "multer": "2.5.0",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "pdf-parse": "2.4.5",
    "prisma": "7.10.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
