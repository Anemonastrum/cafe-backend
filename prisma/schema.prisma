  last_login_at                   DateTime?              @db.DateTime(3)
  created_at                      DateTime               @default(now()) @db.DateTime(3)
  /// Database-managed ON UPDATE CURRENT_TIMESTAMP(3); retained in migration SQL.
  updated_at                      DateTime               @default(now()) @db.DateTime(3)
  fk_sessions_user_back           auth_sessions[]        @relation("fk_sessions_user")
  fk_shifts_cashier_back          cashier_shifts[]       @relation("fk_shifts_cashier")
  fk_shifts_closed_by_back        cashier_shifts[]       @relation("fk_shifts_closed_by")
  fk_orders_cashier_back          orders[]               @relation("fk_orders_cashier")
